<!-- EO:StandaloneOptionsPage -->
<!-- Horizon Connect page; not a Video page: {Binding TimeLockEnabled} -->
<Page xmlns:local="clr-namespace:ForzaUI" xmlns:System="clr-namespace:System;assembly=mscorlib" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ForzaUI.A_VideoOptions" Grid.IsSharedSizeScope="True" Style="{DynamicResource A_Style_Page_Generic}" DataContext="{Binding RelativeSource={RelativeSource Self}}">
<local:UIPageTransitionManager.TransitionManager><local:UIPageTransitionManager DurationSpread="{StaticResource A_Duration_Transition_Spread}" TransitionDelay="{StaticResource A_Duration_Transition_Delay}"/></local:UIPageTransitionManager.TransitionManager>
<Page.Resources><ResourceDictionary>
<local:TileMenuDataItem x:Key="Fh2Tag0" Heading="No servers yet" Description="Your friends' servers show up here. Ask the host for their address (e.g. on Discord) and add it with “Add server” – or host yourself."/>
<local:TileMenuDataItem x:Key="Fh2Tag1" Heading="Add server" Description="Tip: copy the host's address first (Ctrl+C, e.g. in Discord) – it is then filled in by itself."/>
<local:TileMenuDataItem x:Key="Fh2Tag2" Heading="Host a server" Description="Start your own server and invite your friends. The first time, it is set up once."/>
</ResourceDictionary></Page.Resources>
<Grid><ContentControl x:Name="TopBar" Style="{StaticResource A_Style_PlayerBar}"/>
<ContentControl x:Name="BottomBar" Style="{StaticResource A_Style_ButtonBar}"><ContentControl x:Name="DefaultHelpPanel" local:ControllerButtonPanel.ADescription="Select" local:ControllerButtonPanel.BDescription="{local:Loc HelpButtons.IDS_Back}" local:ControllerButtonPanel.XDescription="Edit" local:ControllerButtonPanel.YDescription="Delete" Style="{StaticResource A_Style_ContentControl_DefaultButtonBar}"/></ContentControl>
<Border Style="{StaticResource A_Style_Border_ScenePadding}" SnapsToDevicePixels="True" UseLayoutRounding="True"><Grid x:Name="LayoutRoot">
<ContentControl Style="{StaticResource A_Style_ContentControl_ScreenTilt}" Margin="0,-60,0,0" Focusable="False"><StackPanel Name="BasicOptions" VerticalAlignment="Center" HorizontalAlignment="Center">
<StackPanel Orientation="Horizontal" Margin="0,0,0,6" Style="{StaticResource A_Style_FrameworkElement_DefaultTransition_0}"><ContentControl Tag="{x:Null}" Content="HORIZON CONNECT" Style="{StaticResource A_Style_ContentControl_ScreenTitleBlock}" Focusable="False"/></StackPanel>
<StackPanel Width="806" Style="{StaticResource A_Style_FrameworkElement_DefaultTransition_0}"><Grid local:UIPageTransitionManager.TransitionIndex="0"><local:FZMaterial Color="{StaticResource A_Color_TileSelected_Text}"><local:CommonListBox x:Name="OptionsList" Style="{StaticResource A_Style_ListBox_List_Default}" ItemContainerStyle="{StaticResource A_Style_ListBoxItem_List_Default}" Width="806" Height="165">
<local:SpinnerControl x:Name="FirstItem" Label="No servers yet" Tag="{StaticResource Fh2Tag0}" SelectedIndex="{Binding Fh2Row0}" ItemsSource="{Binding Fh2Items0}" Style="{StaticResource A_Style_SpinnerControl_Default}"/>
<local:SpinnerControl Label="Add server" Tag="{StaticResource Fh2Tag1}" SelectedIndex="{Binding Fh2Row1}" ItemsSource="{Binding Fh2Items1}" Style="{StaticResource A_Style_SpinnerControl_Default}"/>
<local:SpinnerControl Label="Host a server" Tag="{StaticResource Fh2Tag2}" SelectedIndex="{Binding Fh2Row2}" ItemsSource="{Binding Fh2Items2}" Style="{StaticResource A_Style_SpinnerControl_Default}"/>
</local:CommonListBox></local:FZMaterial></Grid><local:FZMaterialGlassCapture/>
<ContentControl Content="{Binding Tag.Description}" DataContext="{Binding SelectedItem, ElementName=OptionsList}" Height="130" Width="806" Template="{StaticResource A_ControlTemplate_DescriptionPanelContent}"/>
</StackPanel></StackPanel></ContentControl></Grid></Border><local:FZMaterial x:Name="Fader" Color="Black" Opacity="0"/></Grid></Page>
